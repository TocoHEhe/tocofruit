-- 2. LOGIC (TỐC ĐỘ BÌNH THƯỜNG & SERVER HOP)
---------------------------------------------------------
_G.AutoStoreFruit = true
local TravelSpeed = 250 -- Tốc độ vừa phải, mượt mà

-- Hàm Server Hop (Fix lỗi thoát ra vô lại)
local function SafeHop()
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local s, res = pcall(function() return game:HttpGet(url) end)
    if s then
        local data = Http:JSONDecode(res)
        for _, server in pairs(data.data) do
            if server.id ~= game.JobId and server.playing < server.maxPlayers then
                pcall(function() TPS:TeleportToPlaceInstance(game.PlaceId, server.id, LP) end)
                task.wait(1)
            end
        end
    end
end

-- Vòng lặp Farm
task.spawn(function()
    while task.wait(1) do
        if _G.AutoStoreFruit then
            local targetFruit = nil
            for _, v in pairs(workspace:GetChildren()) do
                if v.Name:find("Fruit") and (v:IsA("Tool") or v:IsA("Model")) then
                    targetFruit = v
                    break
                end
            end

            if targetFruit then
                local char = LP.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local pos = targetFruit:IsA("Tool") and targetFruit.Handle.Position or targetFruit.PrimaryPart.Position
                    
                    -- BodyVelocity để chống rớt khi bay
                    local bv = Instance.new("BodyVelocity", hrp)
                    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                    bv.Velocity = Vector3.new(0,0,0)
                    
                    local dist = (hrp.Position - pos).Magnitude
                    local tween = TweenService:Create(hrp, TweenInfo.new(dist/TravelSpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
                    tween:Play()
                    tween.Completed:Wait()
                    bv:Destroy()
                    
                    task.wait(0.5)
                    -- Nhặt và cất
                    local tool = char:FindFirstChildOfClass("Tool") or LP.Backpack:FindFirstChildOfClass("Tool")
                    if tool and tool.Name:find("Fruit") then
                        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StoreFruit", tool:GetAttribute("OriginalName") or tool.Name, tool)
                    end
                end
            else
                -- Không có fruit thì hop server
                SafeHop()
                task.wait(10)
            end
        end
    end
end)

