-- Fix Server Hop (Unauthorized/Fail)
local function ServerHop()
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, result = pcall(function() return game:HttpGet(url) end)
    if success then
        local data = Http:JSONDecode(result)
        if data and data.data then
            for _, s in pairs(data.data) do
                if s.id ~= game.JobId and s.playing < s.maxPlayers then
                    pcall(function() TPS:TeleportToPlaceInstance(game.PlaceId, s.id, LP) end)
                    task.wait(0.5) -- Tránh spam request
                end
            end
        end
    end
end

-- Vòng lặp Farm & Hop (Đã tối ưu hóa tránh lỗi)
spawn(function()
    while task.wait(1) do
        if _G.AutoStoreFruit then
            local fruitFound = false
            for _, v in pairs(workspace:GetChildren()) do
                if v.Name:find("Fruit") and (v:IsA("Tool") or v:IsA("Model")) then
                    fruitFound = true
                    local char = LP.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local root = char.HumanoidRootPart
                        local target = v:IsA("Tool") and v.Handle.Position or v.PrimaryPart.Position
                        
                        -- Hiệu ứng bay mượt
                        local bv = Instance.new("BodyVelocity", root)
                        bv.Velocity = Vector3.new(0,0,0)
                        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                        
                        local dist = (root.Position - target).Magnitude
                        local tween = TweenService:Create(root, TweenInfo.new(dist/350, Enum.EasingStyle.Linear), {CFrame = CFrame.new(target)})
                        tween:Play()
                        tween.Completed:Wait()
                        bv:Destroy()
                        
                        task.wait(0.3)
                        local tool = char:FindFirstChildOfClass("Tool") or LP.Backpack:FindFirstChildOfClass("Tool")
                        if tool and tool.Name:find("Fruit") then
                            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StoreFruit", tool:GetAttribute("OriginalName") or tool.Name, tool)
                        end
                    end
                end
            end
            
            if not fruitFound then
                print("Server sạch bóng fruit, đang tìm server mới...")
                ServerHop()
                task.wait(5)
            end
        end
    end
end)

