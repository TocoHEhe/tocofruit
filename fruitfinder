-- Auto Select Team
local main = game.Players.LocalPlayer.PlayerGui:FindFirstChild("Main")
if main and main:FindFirstChild("ChooseTeam") then
    local container = main.ChooseTeam:FindFirstChild("Container")
    if container then
        local teamFrame = container:FindFirstChild("Pirates") -- Mặc định chọn Pirates
        if teamFrame then
            local frame = teamFrame:FindFirstChild("Frame")
            if frame then
                local button = frame:FindFirstChild("TextButton")
                if button then
                    task.wait(0.5)
                    local vim = game:GetService("VirtualInputManager")
                    local pos = button.AbsolutePosition + button.AbsoluteSize / 2
                    vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
                    task.wait(0.1)
                    vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
                end
            end
        end
    end
end

