local function StoreFruit(fruit)
    if fruit then
        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StoreFruit", fruit:GetAttribute("OriginalName") or fruit.Name, fruit)
    end
end

-- Vòng lặp chính tìm Fruit
spawn(function()
    while task.wait(1) do
        for _, f in pairs(workspace:GetChildren()) do
            if f.Name:find("Fruit") and (f:IsA("Tool") or f:IsA("Model")) and f.Parent == workspace then
                local char = lp.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    repeat
                        local hbv = bv:Clone() hbv.Parent = char.HumanoidRootPart
                        local hbav = bav:Clone() hbav.Parent = char.HumanoidRootPart
                        
                        local targetPos = f:IsA("Tool") and f.Handle.Position or f.PrimaryPart.Position
                        local dist = (char.HumanoidRootPart.Position - targetPos).Magnitude
                        local tween = ts:Create(char.HumanoidRootPart, TweenInfo.new(dist/300, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
                        
                        tween:Play()
                        tween.Completed:Wait()
                        
                        hbv:Destroy() hbav:Destroy()
                        task.wait(0.5)
                    until f.Parent ~= workspace or not f
                    
                    -- Cất fruit sau khi nhặt
                    local fruitTool = char:FindFirstChildOfClass("Tool") or lp.Backpack:FindFirstChildOfClass("Tool")
                    if fruitTool and fruitTool.Name:find("Fruit") then
                        StoreFruit(fruitTool)
                    end
                end
            end
        end
    end
end)

-- Server Hopper (Giữ nguyên logic cũ)
spawn(function()
    task.wait(30) -- Đợi 30s trước khi check hop để tránh lag
    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local PlaceId = game.PlaceId
    local JobId = game.JobId

    while task.wait(10) do
        local servers = {}
        local success, res = pcall(function()
            return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
        end)
        
        if success and res.data then
            for _, s in pairs(res.data) do
                if s.id ~= JobId and s.playing < s.maxPlayers then
                    TeleportService:TeleportToPlaceInstance(PlaceId, s.id, lp)
                    break
                end
            end
        end
    end
end)
